{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,src/lib/**,public/painter.js,public/fonts/**,public/brand/**,node_modules/@napi-rs/canvas*/**}"
    }
  },
  "routes": [
    {"handle": "filesystem"},
    {"src": "/api/.*", "status": 404},
    {"src": "/\\.well-known/.*", "status": 404},
    {"src": "/.*", "dest": "/index.html"}
  ]
}
